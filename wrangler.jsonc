{
  "name": "spell-it",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "spell-it-sync", "database_id": "218b5eb6-b7c2-41da-af8a-bc028b0061c0" }
  ]
}
